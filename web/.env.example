# Copy to .env.local for local dev. None of these are secrets (they ship in the page),
# but keep them out of git so forks don't reuse your OAuth client.
VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Browser API key, restricted to your origins + Picker API (used from step 4).
VITE_GOOGLE_API_KEY=
# Cloud project NUMBER (not ID), needed by Google Picker so picked files are granted to drive.file.
VITE_GOOGLE_APP_ID=
